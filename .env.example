# Parcela — unified environment (copy to .env.local at this repo root)
# Web, staff portal, sender booking, and rider tracking all use ONE API + ONE database.

# --- Web app (Next.js) ---
# Same-origin API proxy (Next rewrites /api/* → API_PROXY_TARGET). Keeps httpOnly auth cookies on one origin.
NEXT_PUBLIC_API_URL=/api
# Local dev: http://127.0.0.1:3002  |  Vercel: https://YOUR-API-HOST.com (Render, Railway, etc.)
API_PROXY_TARGET=http://127.0.0.1:3002

# --- Vercel deploy (set in Vercel Project Settings → Environment Variables) ---
# NEXT_PUBLIC_API_URL=/api
# API_PROXY_TARGET=https://parcela-9lhg.onrender.com
# On Render (API), also set:
# PUBLIC_WEB_URL=https://YOUR-PROJECT.vercel.app
# CORS_ORIGINS=https://YOUR-PROJECT.vercel.app,https://YOUR-PROJECT-*.vercel.app

# --- API server (NestJS backend/) ---
PORT=3002
MONGODB_URI=mongodb://127.0.0.1:27017/parcela
CORS_ORIGINS=http://localhost:3001,http://localhost:8081,http://localhost:8082,http://localhost:8083
PUBLIC_WEB_URL=http://localhost:3001
# Deep link scheme for tracking SMS (opens Parcela mobile app)
MOBILE_DEEP_LINK_SCHEME=parcela
# Required — strong unique secret (≥32 chars). Never use parcela-staff-dev-secret.
STAFF_TOKEN_SECRET=

# mNotify SMS — https://mnotify.com
# On localhost (NODE_ENV !== production), HQ logins use P@$$w0rd instead of SMS.
MNOTIFY_ENABLED=false
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=Parcela
MNOTIFY_BASE_URL=https://api.mnotify.com/api

# Database seeding (runs on API startup by default)
SEED_ON_STARTUP=true
SEED_RESET=false

# Parcela platform admin — only auto-seeded login account
PLATFORM_ADMIN_EMAIL=amusahcongo@gmail.com
SEED_PLATFORM_PASSWORD=
# Phone for platform login security SMS (Ghana format, e.g. 0531878243)
PLATFORM_ADMIN_PHONE=

# --- Mobile (Expo) — optional, set in mobile/.env or app config ---
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3002/api

# --- Web (Next.js) demo login quick-fill (dev only) ---
# NEXT_PUBLIC_PLATFORM_ADMIN_EMAIL=amusahcongo@gmail.com
# NEXT_PUBLIC_PLATFORM_DEMO_PASSWORD=
