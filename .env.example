# Parcela — environment variables

# Next.js web app
NEXT_PUBLIC_API_URL=http://localhost:3002/api

# Expo mobile app (set in mobile/.env or app config)
# EXPO_PUBLIC_API_URL=http://localhost:3002/api

# Backend (see backend/.env.example)
# MONGODB_URI=mongodb://127.0.0.1:27017/parcela
# MNOTIFY_API_KEY=
# MNOTIFY_SENDER_ID=Parcela
# MNOTIFY_ENABLED=false
