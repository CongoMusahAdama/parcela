# Server
PORT=3002

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/parcela

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:8081,http://localhost:8082,http://localhost:8083

# Public web URL (used in SMS tracking links)
PUBLIC_WEB_URL=http://localhost:3001

# Staff portal auth (change in production)
# Required — strong unique secret (≥32 chars). Never use parcela-staff-dev-secret.
STAFF_TOKEN_SECRET=

# mNotify SMS — https://mnotify.com
# Set MNOTIFY_ENABLED=true when you have an API key and approved sender ID
MNOTIFY_ENABLED=false
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=Parcela
MNOTIFY_BASE_URL=https://api.mnotify.com/api

# Database seeding (runs on API startup by default; set false in production)
SEED_ON_STARTUP=true
# Set SEED_RESET=true to remove any legacy demo parcels from the database
SEED_RESET=false
# Production: SEED_ON_STARTUP=false and run `npm run seed` manually when station data changes

# Demo seed account credentials (local/dev only — leave blank in production)
SEED_STAFF_PASSWORD=
SEED_STAFF_PIN=
SEED_LEAD_PASSWORD=
SEED_LEAD_PIN=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PIN=
